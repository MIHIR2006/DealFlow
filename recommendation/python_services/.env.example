# Shared
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealflow360

# Recommendation Engine
MARGIN_THRESHOLD_PCT=20.0
TOP_K=10
MIN_SUPPORT=3
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10
DB_COMMAND_TIMEOUT=10.0

# AI Salesman
# Must include the API version prefix: the portal routes live at /api/v1/portal/q/{token}
BACKEND_BASE_URL=http://localhost:8080/api/v1
BACKEND_TIMEOUT_SECONDS=10.0
# openai | google  (google == Gemini)
LLM_PROVIDER=groq
# Leave empty to take the provider default: gpt-4o for openai,
# gemini-2.5-flash for google.
LLM_MODEL=openai/gpt-oss-120b

# Leave empty to run without the assistant: the service still starts and
# reports itself unavailable, and the customer portal hides the chat panel.
LLM_API_KEY=

# Optional. A staff-role JWT lets the assistant read internal discount
# ceilings for context. Left empty it runs without them, which keeps internal
# thresholds out of a customer-facing prompt.
SERVICE_ACCOUNT_JWT=

# Whether the assistant may confirm a quotation on the customer's behalf.
# Off by default: the portal takes confirmation behind an explicit signatory
# attestation, and a chat turn is not that attestation.
ALLOW_ASSISTANT_CONFIRM=false

SESSION_TTL_SECONDS=3600
AI_SALESMAN_HOST=0.0.0.0
AI_SALESMAN_PORT=8002

# Shared runtime
ENVIRONMENT=development
