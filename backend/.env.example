# Copy to .env and fill in. Every value here is validated at boot;
# the server refuses to start if something required is missing.

APP_ENV=dev
PORT=8080
LOG_LEVEL=debug

# Postgres (Neon). Keep sslmode=require for hosted databases.
DATABASE_URL=postgres://user:password@host/dealflow360?sslmode=require

DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE=30m
DB_QUERY_TIMEOUT=5s

# Must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-min-32
JWT_TTL=12h
PORTAL_TOKEN_TTL=336h

# Comma separated. "*" is rejected when APP_ENV=prod.
CORS_ORIGINS=http://localhost:3000

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

# Emits X-DB-Queries / X-DB-Time-Ms response headers.
EXPOSE_DB_STATS=true

# Deal-health thresholds. A quotation untouched for longer than the stall
# window is flagged; a discount above a rep's own baseline by the multiplier
# is flagged as an anomaly, once that rep has at least the minimum sample.
DEAL_STALL_DAYS=7
DEAL_ANOMALY_MULTIPLIER=1.5
DEAL_ANOMALY_MIN_SAMPLE=3
