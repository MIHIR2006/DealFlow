# DealFlow360 Docker Compose Environment Configuration

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=dealflow360
POSTGRES_PORT=5432

# Backend Service
APP_ENV=dev
BACKEND_PORT=8080
JWT_SECRET=changeme-this-is-a-super-secret-key-that-is-at-least-32-chars

# Recommendation Engine
# The backend calls it for the rep upsell panel and falls back to the
# upsell_rules pairings whenever it is slow, down, or has nothing to offer.
RECOMMENDATION_PORT=8001
RECOMMENDATION_TIMEOUT=1500ms
MARGIN_THRESHOLD_PCT=20.0
TOP_K=10
MIN_SUPPORT=3

# Customer portal AI assistant (optional)
# Leave LLM_API_KEY empty to run without it: the service still starts and the
# portal simply does not show the assistant.
AI_SALESMAN_PORT=8002
# openai | google  (google == Gemini)
LLM_PROVIDER=google
# Empty takes the provider default: gpt-4o for openai, gemini-2.5-flash for google.
LLM_MODEL=
LLM_API_KEY=
# Optional staff-role JWT giving the assistant read access to discount
# ceilings for context. Empty keeps internal thresholds out of the prompt.
SERVICE_ACCOUNT_JWT=
# Whether the assistant may confirm a quotation on the customer's behalf.
# Off by default: the portal takes confirmation behind a signatory attestation.
ALLOW_ASSISTANT_CONFIRM=false
SESSION_TTL_SECONDS=3600

# Frontend
FRONTEND_PORT=3000

# Nginx & Let's Encrypt / Certbot SSL
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
